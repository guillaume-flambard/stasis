    "test:watch": "bun test --watch"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "license": "MIT",
  "devDependencies": {
    "bun-types": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
