{
  "name": "stasis",
  "version": "0.1.0",
  "description": "Multi-project scoring & sprint orchestrator — anti-scatter meta-layer",
  "type": "module",
  "bin": {
    "stasis": "./src/cli.ts"
  },
  "scripts": {
